# Claude auth for the agent (Claude Agent SDK / Claude Code): an API key, or a subscription
# token from `claude setup-token`.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Other providers, chosen by the model id: `openrouter/<slug>` (Claude Code against OpenRouter)
# and `codex/<model>` (Codex CLI). Their runs report no cost in USD; see "Providers" in the README.
# HARNESS_OPENROUTER_API_KEY=
# No key = the CLI's saved login (`codex login`), which doesn't reach a container.
# HARNESS_CODEX_API_KEY=
# HARNESS_CODEX_BINARY=codex

# HARNESS_REDIS_URL=redis://localhost:6379/0
# HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/harness
# Bearer token for the HTTP API (any long random string, e.g. `openssl rand -hex 32`). Empty =
# only requests from this machine are accepted; under docker compose that refuses even the host's
# browser, so set it there.
HARNESS_API_TOKEN=
# Where the MCP server (python -m app.mcp_server) reaches the API.
# HARNESS_API_URL=http://localhost:8000
HARNESS_WORKER_CONCURRENCY=2
HARNESS_TASK_TIMEOUT_SECONDS=3600
HARNESS_DEFAULT_MODEL=claude-opus-5-5
# Models offered by the board's picker on a story (JSON list).
# HARNESS_MODELS=["claude-opus-5-5","claude-sonnet-5-5","claude-haiku-5-5","claude-fable-5-1","codex/gpt-5.5","openrouter/anthropic/claude-opus-5"]
HARNESS_DEFAULT_MAX_BUDGET_USD=5
# The agent's Bash runs in an OS sandbox by default (writes only in the workspace, secret files
# unreadable). Disabling it lets Bash read .env, /proc/1/environ and other processes' argv.
# You can also allow only these command prefixes (JSON list; empty = any command). Commands
# outside the list are denied and the run fails.
# HARNESS_SANDBOX=false
# Hosts the agent's shell may reach, the same for Claude and Codex (JSON list; `*.host` = its
# subdomains; empty = no network). The default is GitHub, PyPI and npm.
# HARNESS_ALLOWED_DOMAINS=["github.com","*.github.com","pypi.org","files.pythonhosted.org"]
# Lean context: a short system prompt instead of Claude Code's preset and no CLAUDE.md/skills
# preloaded. A task can override it with "lean_context". (Every agent gets only the allowed
# tools' definitions, lean or not.)
# HARNESS_LEAN_CONTEXT=true
# A `resume` step continues the role's session only while its last request read at most this
# many tokens; past it the step starts a new session from the artifacts (0 = no limit).
# HARNESS_RESUME_MAX_CONTEXT_TOKENS=60000
# HARNESS_BASH_ALLOWED_COMMANDS='["uv run","pytest","ruff","git status","git diff","git log","ls","cat"]'

# Where agents' clones live (default ./workspaces, inside this checkout). The sandbox confines
# writes only, so an agent can read and run what sits next to its workspace, such as this
# checkout's .venv; a directory outside the checkout keeps that out of reach.
# HARNESS_WORKSPACES_ROOT=/var/lib/harness/workspaces
# Remove finished/deleted workspaces older than this many hours, hourly (0 = off).
# HARNESS_WORKSPACE_TTL_HOURS=72

# Board terminal: shell commands in a story's workspace. Remote code execution on the worker:
# needs HARNESS_API_TOKEN, and commands run without HARNESS_* in their environment.
# HARNESS_TERMINAL_ENABLED=true
# HARNESS_TERMINAL_TIMEOUT_SECONDS=120

# GitHub issue workflow: fine-grained PAT with Contents, Issues, Pull requests = read/write.
HARNESS_GITHUB_TOKEN=
# GitHub App (preferred): access only to the repos chosen at install time, 1-hour tokens.
# Create it at github.com/settings/apps/new: permissions Contents, Issues, Pull requests, Checks,
# Actions (logs) = read/write as needed; "Only on this account"; Setup URL = <host>/board with
# "Redirect on update" checked. Then generate a private key. Projects pick an installation in the UI.
# HARNESS_GITHUB_APP_ID=
# HARNESS_GITHUB_APP_SLUG=
# PEM with literal \n for newlines (scrubbed from agent subprocesses), or a file path:
# HARNESS_GITHUB_APP_PRIVATE_KEY=
# HARNESS_GITHUB_APP_PRIVATE_KEY_FILE=
# GitHub webhook at <host>/github/webhook (events: check runs, check suites, statuses, pull
# requests). Set = CI and merge are re-checked on events, and polling drops to the fallback interval.
# HARNESS_GITHUB_WEBHOOK_SECRET=
# HARNESS_CHECKS_POLL_SECONDS=30
# HARNESS_CHECKS_FALLBACK_POLL_SECONDS=300
# Poll these repos for issues labelled HARNESS_ISSUE_LABEL (JSON list). Empty = off.
HARNESS_ISSUE_REPOS=[]
HARNESS_ISSUE_LABEL=agent
HARNESS_ISSUE_POLL_SECONDS=300
# Scheduler: agents at once (worker concurrency must be at least this) and subscription pacing.
HARNESS_MAX_AGENTS=4
HARNESS_MAX_AGENTS_PER_PROJECT=2
# HARNESS_QUOTA_THROTTLE_AT=0.8
# HARNESS_QUOTA_PAUSE_AT=0.95
# HARNESS_QUOTA_PACE_SLACK=0.1

# Gate before push, e.g. "make test" or "uv run pytest -q && uv run ruff check".
HARNESS_ISSUE_VERIFY_COMMAND=
